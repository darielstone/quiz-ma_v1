setlike () modifie la variable likes et oblige a redessiner l'affichage 
import { useEffect, useState } from "react";
function Compteur(){
  const [likes , setlikes] = useState<number>(()=>{
    return Number (localStorage.getItem("mesLikes") || 0)
  })
  useEffect(()=> {
    localStorage.setItem("mesLikes",String(likes))
  },[likes])
  return (
    <> 
    <p>Il ya {likes} likes</p><br /> 
    <button className="btn btn-primary" onClick={()=> setlikes(likes+1 )}>Liker</button>
    </>
  )
}
export default Compteur 
creer un useState pour les question histoire de redessiner l'interface pour chaque question